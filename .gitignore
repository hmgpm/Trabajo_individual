# ===============================
#  PYTHON
# ===============================
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
*.egg
*.pyc
*.pyd
*.pyo

# ===============================
#  VIRTUAL ENVIRONMENTS
# ===============================
.env
.venv
venv/
ENV/
env/

# ===============================
#  JUPYTER NOTEBOOK
# ===============================
.ipynb_checkpoints/
*.ipynb
*/.ipynb_checkpoints/

# ===============================
#  DATA FILES (generados - ignorar casi todos)
# ===============================
*.csv
*.gexf
*.gephi

# EXCEPCIÓN: permitir el proyecto manual de Gephi
!data/gephi/Proyecto_IA.gephi

# Permite incluir los archivos CSV de data/raw
data/raw/*.csv

# ===============================
#  IMAGES (ignorar todos los PNG excepto los de Gephi)
# ===============================
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg

# EXCEPCIÓN: mantener los grafos semánticos de Gephi
!data/gephi/gephi_*.png

